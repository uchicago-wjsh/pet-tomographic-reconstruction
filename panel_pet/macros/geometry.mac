# ===========================================================================
#  geometry.mac -- four-panel PET scanner
#
#  Basic module : 12 x 12 crystals of 4 x 4 x 5 mm LYSO, no gaps
#                 -> 48 x 48 mm face, 5 mm thick
#  Primary plates (top/bottom) : 10 x 10 modules = 48 x 48 cm, 40 cm apart
#  Side plates    (left/right) : 10 x 8  modules = 48 x 38.4 cm, 45 cm apart
#
#  All 360 modules are placed by a single genericRepeater reading
#  data/module.placements (generated by scripts/make_placements.py). That
#  file also documents the module-ID -> plate mapping.
#
#  System: PETscanner. The generic "scanner" system cannot produce
#  Coincidences -- only "PETscanner" can -- and unlike cylindricalPET it
#  imposes no ring geometry, which is what a four-panel scanner needs.
#    level1 = module   (360 placements)
#    level2 = crystal  (12 x 12 per module)
#
#  Everything except the crystals is Vacuum: the task specifies no
#  attenuator, and air would still remove ~0.5% of coincidences over a
#  40 cm path -- comparable to the 1% precision being targeted.
# ===========================================================================

/gate/geometry/setMaterialDatabase GateMaterials.db

# ---------------------------------------------------------------------------
#  W O R L D
# ---------------------------------------------------------------------------
/gate/world/geometry/setXLength 60. cm
/gate/world/geometry/setYLength 60. cm
/gate/world/geometry/setZLength 60. cm
/gate/world/setMaterial Vacuum

# ---------------------------------------------------------------------------
#  S Y S T E M   E N V E L O P E
#  Must contain the panels: x +/-230, y +/-205, z +/-240 mm.
# ---------------------------------------------------------------------------
/gate/world/daughters/name PETscanner
/gate/world/daughters/insert box
/gate/PETscanner/geometry/setXLength 480. mm
/gate/PETscanner/geometry/setYLength 420. mm
/gate/PETscanner/geometry/setZLength 490. mm
/gate/PETscanner/setMaterial Vacuum
/gate/PETscanner/vis/forceWireframe
/gate/PETscanner/vis/setColor white

# ---------------------------------------------------------------------------
#  L E V E L 1 :  M O D U L E
#  Local frame: X = 5 mm depth, Y = 48 mm, Z = 48 mm.
#  The placements file rotates the primary-plate copies +90 deg about z so
#  their depth runs along y; side-plate copies are unrotated.
# ---------------------------------------------------------------------------
/gate/PETscanner/daughters/name module
/gate/PETscanner/daughters/insert box
/gate/module/geometry/setXLength  5. mm
/gate/module/geometry/setYLength 48. mm
/gate/module/geometry/setZLength 48. mm
/gate/module/setMaterial Vacuum
/gate/module/vis/setColor blue
/gate/module/vis/forceWireframe

/gate/module/repeaters/insert genericRepeater
/gate/module/genericRepeater/setPlacementsFilename data/module.placements
/gate/module/genericRepeater/useRelativeTranslation 0

# ---------------------------------------------------------------------------
#  L E V E L 2 :  C R Y S T A L
#  12 x 12 array of 4 x 4 x 5 mm LYSO, pitch = size (no gaps), exactly
#  filling the 48 x 48 x 5 mm module.
# ---------------------------------------------------------------------------
/gate/module/daughters/name crystal
/gate/module/daughters/insert box
/gate/crystal/geometry/setXLength 5. mm
/gate/crystal/geometry/setYLength 4. mm
/gate/crystal/geometry/setZLength 4. mm
/gate/crystal/setMaterial LYSO
/gate/crystal/vis/setColor red

/gate/crystal/repeaters/insert cubicArray
/gate/crystal/cubicArray/setRepeatNumberX 1
/gate/crystal/cubicArray/setRepeatNumberY 12
/gate/crystal/cubicArray/setRepeatNumberZ 12
/gate/crystal/cubicArray/setRepeatVector 0. 4. 4. mm

# ---------------------------------------------------------------------------
#  A T T A C H   T O   T H E   S Y S T E M
# ---------------------------------------------------------------------------
/gate/systems/PETscanner/level1/attach module
/gate/systems/PETscanner/level2/attach crystal

/gate/crystal/attachCrystalSD
